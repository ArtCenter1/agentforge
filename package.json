{
  "name": "expo-gemini-agent-boilerplate",
  "version": "1.0.0",
  "description": "Expo boilerplate: Google Auth + Gemini Agent + Tool Calling + Camera Vision + SQLite. AionUi-inspired for mobile.",
  "main": "expo-router/entry",
  "scripts": {
