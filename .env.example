# ============================================================
#  AGENTFORGE — ENVIRONMENT VARIABLES
#
#  Copy this file to .env and fill in your values.
#  Only fill in keys for features you have enabled in
#  src/config/features.ts — the rest can stay blank.
#
#  NEVER commit your .env file to git.
#  It is already listed in .gitignore.
# ============================================================


# ── App Identity ─────────────────────────────────────────────
# Must match app.json: name, slug, and scheme fields.
EXPO_PUBLIC_APP_NAME=AgentForge
EXPO_PUBLIC_APP_SLUG=agentforge
EXPO_PUBLIC_APP_SCHEME=agentforge
EXPO_PUBLIC_ENV=development


# ── Google OAuth ─────────────────────────────────────────────
# Required when: FEATURES.googleAuth = true
#
# How to get:
#   1. console.cloud.google.com → APIs & Services → Credentials
#   2. Create OAuth 2.0 Client ID → Web application
#   3. Add redirect URI: https://auth.expo.io/@YOUR_EXPO_USER/YOUR_SLUG
#
EXPO_PUBLIC_GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com

# Optional: platform-specific client IDs for native builds
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=your-ios-client-id.apps.googleusercontent.com
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=your-android-client-id.apps.googleusercontent.com


# ── Gemini API ───────────────────────────────────────────────
# Required when: FEATURES.gemini = true
#
# How to get:
#   aistudio.google.com/app/apikey → Create API key
#
EXPO_PUBLIC_GEMINI_API_KEY=your-gemini-api-key

# Model selection (optional — defaults shown)
# Options: gemini-2.5-flash | gemini-2.5-pro | gemini-1.5-flash | gemini-1.5-pro
EXPO_PUBLIC_GEMINI_MODEL=gemini-2.5-flash
EXPO_PUBLIC_GEMINI_VISION_MODEL=gemini-2.5-flash


# ── YouTube Data API v3 ───────────────────────────────────────
# Required when: FEATURES.tools.youtubeSearch = true
#
# How to get:
#   1. console.cloud.google.com → Enable "YouTube Data API v3"
#   2. APIs & Services → Credentials → Create API Key
#
EXPO_PUBLIC_YOUTUBE_API_KEY=your-youtube-api-key
EXPO_PUBLIC_YOUTUBE_MAX_RESULTS=8


# ── Google Custom Search ──────────────────────────────────────
# Required when: FEATURES.tools.webSearch = true
#
# How to get:
#   1. programmablesearchengine.google.com → Create search engine
#   2. console.cloud.google.com → Enable "Custom Search API" → Create API Key
#
EXPO_PUBLIC_GOOGLE_SEARCH_API_KEY=your-search-api-key
EXPO_PUBLIC_SEARCH_ENGINE_ID=your-search-engine-id
